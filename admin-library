  <script>
    function escapeHtml(s) {
      if (s == null) return '';
      return String(s).replace(/[&<>"']/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
    }
    function showToast(msg) {
      const t = document.getElementById('toast');
      t.textContent = msg;
      t.classList.add('show');
      setTimeout(() => t.classList.remove('show'), 2600);
    }
    document.getElementById('btn-signout')?.addEventListener('click', () => {
      if (window.AdminApp && window.AdminApp.handleSignOut) window.AdminApp.handleSignOut();
    });

    document.addEventListener('adminapp:ready', () => {
      const A = window.AdminApp;
      if (!A) return;

      let currentBrand = 'all';
      let viewYear = new Date().getFullYear();
      let viewMonth = new Date().getMonth(); // 0-indexed

      const MONTH_NAMES = ['Januari','Februari','Maret','April','Mei','Juni','Juli','Agustus','September','Oktober','November','Desember'];

      function libraryItems() {
        return (A.data.library || []).filter(l => currentBrand === 'all' || l.brand === currentBrand);
      }

      function renderAll() {
        renderCalendar();
        renderUnscheduledPool();
      }

      function renderCalendar() {
        document.getElementById('cal-month-label').textContent = MONTH_NAMES[viewMonth] + ' ' + viewYear;
        const grid = document.getElementById('cal-grid');
        grid.innerHTML = '';

        const firstOfMonth = new Date(viewYear, viewMonth, 1);
        const startWeekday = firstOfMonth.getDay(); // 0=Sun
        const daysInMonth = new Date(viewYear, viewMonth + 1, 0).getDate();
        const daysInPrevMonth = new Date(viewYear, viewMonth, 0).getDate();
        const todayStr = new Date().toISOString().slice(0, 10);

        const items = libraryItems().filter(l => l.scheduled_date);
        const byDate = {};
        items.forEach(l => {
          const key = l.scheduled_date;
          if (!byDate[key]) byDate[key] = [];
          byDate[key].push(l);
        });

        const cells = [];
        // leading days from prev month
        for (let i = startWeekday - 1; i >= 0; i--) {
          cells.push({ day: daysInPrevMonth - i, otherMonth: true, dateStr: null });
        }
        // days of current month
        for (let d = 1; d <= daysInMonth; d++) {
          const dateStr = viewYear + '-' + String(viewMonth + 1).padStart(2, '0') + '-' + String(d).padStart(2, '0');
          cells.push({ day: d, otherMonth: false, dateStr });
        }
        // trailing days to complete the grid (multiples of 7)
        let trail = 1;
        while (cells.length % 7 !== 0) {
          cells.push({ day: trail++, otherMonth: true, dateStr: null });
        }

        cells.forEach(cell => {
          const div = document.createElement('div');
          div.className = 'cal-day' + (cell.otherMonth ? ' other-month' : '') + (cell.dateStr === todayStr ? ' today' : '');
          const numEl = document.createElement('div');
          numEl.className = 'cal-day-num';
          numEl.textContent = cell.day;
          div.appendChild(numEl);
          if (cell.dateStr && byDate[cell.dateStr]) {
            byDate[cell.dateStr].forEach(item => {
              const chip = document.createElement('div');
              chip.className = 'cal-chip' + (item.status === 'assigned' ? ' assigned' : '');
              chip.textContent = (item.ref_number ? '#' + item.ref_number + ' ' : '') + (item.usp || item.brand);
              chip.title = item.usp || '';
              chip.addEventListener('click', () => openDetailModal(item.id));
              div.appendChild(chip);
            });
          }
          grid.appendChild(div);
        });
      }

      function renderUnscheduledPool() {
        const pool = document.getElementById('unscheduled-pool');
        const items = libraryItems().filter(l => !l.scheduled_date);
        if (!items.length) {
          pool.innerHTML = '<div class="empty-pool">Semua script udah dijadwalkan.</div>';
          return;
        }
        pool.innerHTML = '';
        items.forEach(item => {
          const div = document.createElement('div');
          div.className = 'pool-item';
          div.innerHTML = `
            <span class="brand-tag">${escapeHtml(item.brand)}</span>
            <div class="title">${escapeHtml(item.ref_number ? '#' + item.ref_number + ' — ' : '') + escapeHtml(item.usp || 'Tanpa USP')}</div>
            <div class="sub">${escapeHtml(item.funnel_stage || '')}</div>
          `;
          div.addEventListener('click', () => openDetailModal(item.id));
          pool.appendChild(div);
        });
      }

      // ---- Detail modal ----
      const detailModal = document.getElementById('detail-modal');
      let currentDetailId = null;

      function openDetailModal(id) {
        const item = (A.data.library || []).find(l => l.id === id);
        if (!item) return;
        currentDetailId = id;

        document.getElementById('detail-status').textContent = item.status === 'assigned' ? 'Sudah di-assign' : 'Belum di-assign';
        document.getElementById('detail-status').className = 'status-pill ' + (item.status === 'assigned' ? 'assigned' : 'unassigned');
        document.getElementById('detail-title').textContent = (item.ref_number ? '#' + item.ref_number + ' — ' : '') + (item.usp || 'Tanpa USP');
        document.getElementById('detail-meta').textContent = item.brand + (item.funnel_stage ? ' · ' + item.funnel_stage : '');
        document.getElementById('detail-usp').textContent = item.usp || '—';
        document.getElementById('detail-brief').textContent = item.brief_text || '—';
        document.getElementById('detail-content').textContent = item.content || '—';

        const extraParts = [];
        if (item.brand_guideline_url) extraParts.push('Brand guideline: ' + item.brand_guideline_url);
        if (item.voucher_code) extraParts.push('Kode voucher: ' + item.voucher_code);
        document.getElementById('detail-extra-wrap').style.display = extraParts.length ? '' : 'none';
        document.getElementById('detail-extra').textContent = extraParts.join(' · ');

        document.getElementById('detail-date').value = item.scheduled_date || '';

        const assignedBlock = document.getElementById('detail-assigned-block');
        const assignBlock = document.getElementById('detail-assign-block');
        const assignForm = document.getElementById('assign-form');
        assignForm.style.display = 'none';
        if (item.status === 'assigned') {
          assignedBlock.style.display = '';
          assignBlock.style.display = 'none';
          const kreatorProfile = (A.data.profiles || []).find(p => p.username === item.assigned_to);
          const kreatorLabel = kreatorProfile ? (kreatorProfile.display_name || kreatorProfile.username) : item.assigned_to;
          assignedBlock.querySelector('#detail-assigned-info').innerHTML = escapeHtml(kreatorLabel) +
            (item.brief_id ? ' · <a href="screens-admin-brief-detail.html?id=' + encodeURIComponent(item.brief_id) + '" style="color: var(--accent);">Buka brief →</a>' : '');
        } else {
          assignedBlock.style.display = 'none';
          assignBlock.style.display = '';
          const kreators = (A.data.profiles || []).filter(p => p.role === 'kreator');
          const sel = document.getElementById('assign-kreator-select');
          sel.innerHTML = '<option value="">— Pilih kreator —</option>' +
            kreators.map(p => `<option value="${escapeHtml(p.username)}">${escapeHtml(p.display_name || p.username)}</option>`).join('');
        }

        document.getElementById('btn-delete-script').style.display = item.status === 'assigned' ? 'none' : '';

        detailModal.classList.add('show');
      }
      function closeDetailModal() { detailModal.classList.remove('show'); currentDetailId = null; }
      document.getElementById('detail-close').addEventListener('click', closeDetailModal);
      document.getElementById('detail-cancel').addEventListener('click', closeDetailModal);
      detailModal.addEventListener('click', (e) => { if (e.target === detailModal) closeDetailModal(); });

      document.getElementById('detail-date').addEventListener('change', async (e) => {
        if (!currentDetailId) return;
        try {
          await A.scheduleLibraryScript(currentDetailId, e.target.value || null);
          showToast(e.target.value ? 'Tanggal jadwal disimpan ✓' : 'Dibalikin ke pool belum dijadwalkan.');
          renderAll();
        } catch (err) {
          showToast('Gagal: ' + err.message);
        }
      });

      document.getElementById('btn-open-assign').addEventListener('click', () => {
        document.getElementById('assign-form').style.display = '';
      });

      document.getElementById('btn-confirm-assign').addEventListener('click', async () => {
        if (!currentDetailId) return;
        const kreator = document.getElementById('assign-kreator-select').value;
        const deadline = document.getElementById('assign-deadline').value.trim();
        const feeRaw = document.getElementById('assign-fee').value.trim();
        if (!kreator) { showToast('Pilih kreator dulu.'); return; }
        const btn = document.getElementById('btn-confirm-assign');
        btn.disabled = true;
        const orig = btn.textContent;
        btn.textContent = 'Menyimpan…';
        try {
          await A.assignLibraryScript(currentDetailId, {
            kreator,
            deadline: deadline || '—',
            fee: feeRaw === '' ? undefined : Number(feeRaw)
          });
          showToast('Berhasil di-assign, brief & script udah kebuat ✓');
          closeDetailModal();
          renderAll();
        } catch (err) {
          showToast('Gagal: ' + err.message);
        } finally {
          btn.disabled = false;
          btn.textContent = orig;
        }
      });

      document.getElementById('btn-delete-script').addEventListener('click', async () => {
        if (!currentDetailId) return;
        if (!confirm('Hapus script ini dari library? Aksi ini gak bisa dibatalin.')) return;
        try {
          await A.deleteLibraryScript(currentDetailId);
          showToast('Script dihapus.');
          closeDetailModal();
          renderAll();
        } catch (err) {
          showToast('Gagal: ' + err.message);
        }
      });

      // ---- Add script modal ----
      const addModal = document.getElementById('add-modal');
      document.getElementById('btn-add-script').addEventListener('click', () => {
        ['add-ref','add-funnel','add-usp','add-brief','add-content','add-guideline','add-voucher'].forEach(id => {
          document.getElementById(id).value = '';
        });
        addModal.classList.add('show');
      });
      function closeAddModal() { addModal.classList.remove('show'); }
      document.getElementById('add-cancel').addEventListener('click', closeAddModal);
      addModal.addEventListener('click', (e) => { if (e.target === addModal) closeAddModal(); });

      document.getElementById('btn-save-add').addEventListener('click', async () => {
        const brand = document.getElementById('add-brand').value;
        const usp = document.getElementById('add-usp').value.trim();
        if (!usp) { showToast('USP wajib diisi.'); return; }
        const btn = document.getElementById('btn-save-add');
        btn.disabled = true;
        const orig = btn.textContent;
        btn.textContent = 'Menyimpan…';
        try {
          await A.createLibraryScript({
            brand,
            refNumber: document.getElementById('add-ref').value.trim(),
            funnelStage: document.getElementById('add-funnel').value.trim(),
            usp,
            briefText: document.getElementById('add-brief').value.trim(),
            content: document.getElementById('add-content').value.trim(),
            brandGuidelineUrl: document.getElementById('add-guideline').value.trim(),
            voucherCode: document.getElementById('add-voucher').value.trim()
          });
          showToast('Script ditambahin ke library ✓');
          closeAddModal();
          renderAll();
        } catch (err) {
          showToast('Gagal: ' + err.message);
        } finally {
          btn.disabled = false;
          btn.textContent = orig;
        }
      });

      // ---- Brand filter ----
      document.getElementById('brand-chips').addEventListener('click', (e) => {
        const chip = e.target.closest('.brand-chip');
        if (!chip) return;
        document.querySelectorAll('#brand-chips .brand-chip').forEach(c => c.classList.remove('active'));
        chip.classList.add('active');
        currentBrand = chip.dataset.brand;
        renderAll();
      });

      // ---- Calendar month nav ----
      document.getElementById('cal-prev').addEventListener('click', () => {
        viewMonth--; if (viewMonth < 0) { viewMonth = 11; viewYear--; }
        renderCalendar();
      });
      document.getElementById('cal-next').addEventListener('click', () => {
        viewMonth++; if (viewMonth > 11) { viewMonth = 0; viewYear++; }
        renderCalendar();
      });

      // ---- Realtime data refresh ----
      document.addEventListener('adminapp:data-changed', renderAll);

      renderAll();
    });
  </script>
</body>
</html>
