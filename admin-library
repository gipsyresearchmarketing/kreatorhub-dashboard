  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap">
  <style>
    :root {
      --bg:      oklch(99% 0.002 240);
      --surface: oklch(100% 0 0);
      --fg:      oklch(18% 0.012 250);
      --muted:   oklch(54% 0.012 250);
      --border:  oklch(92% 0.005 250);
      --accent:  oklch(58% 0.18 255);
      --accent-soft: color-mix(in oklch, var(--accent) 14%, transparent);
      --fg-soft:     color-mix(in oklch, var(--fg) 6%, transparent);
      --success: oklch(62% 0.14 150);
      --warn:    oklch(72% 0.14 70);
      --danger:  oklch(58% 0.18 25);

      --font-display: 'Plus Jakarta Sans', system-ui, sans-serif;
      --font-body:    'Plus Jakarta Sans', system-ui, sans-serif;
      --font-mono:    'Plus Jakarta Sans', system-ui, sans-serif;

      --fs-h1: clamp(24px, 3vw, 32px);
      --fs-h2: clamp(20px, 2.4vw, 26px);
      --fs-body: 14px;
      --fs-meta: 11px;

      --gap-md: 16px;
      --gap-lg: 24px;
      --gutter: 24px;
      --radius: 8px;
      --radius-lg: 12px;
    }
    *, *::before, *::after { box-sizing: border-box; }
    body { margin: 0; background: var(--bg); color: var(--fg); font-family: var(--font-body); font-size: var(--fs-body); line-height: 1.55; }
    a { color: inherit; text-decoration: none; }
    button { font: inherit; cursor: pointer; font-family: inherit; }
    h1, h2, h3 { margin: 0; font-family: var(--font-display); }

    .topnav { position: sticky; top: 0; z-index: 100; background: color-mix(in oklch, var(--bg) 92%, transparent); backdrop-filter: blur(12px); border-bottom: 1px solid var(--border); }
    .topnav-inner { display: flex; align-items: center; justify-content: space-between; padding-block: 12px; padding-inline: var(--gutter); }
    .brand-logo { display: flex; align-items: center; gap: 10px; }
    .brand-logo .logo-mark { width: 28px; height: 28px; border-radius: 7px; background: var(--accent); color: var(--surface); display: grid; place-items: center; font-weight: 700; font-size: 14px; }
    .brand-logo .logo-text { font-weight: 600; font-size: 16px; }
    .topnav-right { display: flex; align-items: center; gap: var(--gap-md); }
    .meta { font-size: var(--fs-meta); color: var(--muted); }
    .avatar { width: 28px; height: 28px; border-radius: 50%; background: var(--accent-soft); color: var(--accent); display: grid; place-items: center; font-size: 10px; font-weight: 600; }

    .shell { display: grid; grid-template-columns: 220px 1fr; min-height: calc(100vh - 50px); }
    @media (max-width: 900px) { .shell { grid-template-columns: 1fr; } .side-nav { display: none; } }
    .side-nav { border-right: 1px solid var(--border); background: var(--surface); padding: 20px 12px; display: flex; flex-direction: column; gap: 4px; }
    .side-nav .brand-mini { font-family: var(--font-display); font-size: 15px; font-weight: 600; padding: 0 8px 12px; border-bottom: 1px solid var(--border); margin-bottom: 8px; }
    .side-nav a { display: flex; align-items: center; gap: 10px; padding: 8px 10px; border-radius: 8px; font-size: 13px; color: var(--muted); }
    .side-nav a:hover { background: var(--fg-soft); color: var(--fg); }
    .side-nav a.active { background: var(--accent-soft); color: var(--fg); font-weight: 500; box-shadow: inset 2px 0 0 0 var(--accent); }
    .side-nav svg { width: 16px; height: 16px; opacity: 0.7; flex-shrink: 0; }
    .side-nav a.active svg { opacity: 1; }
    .side-nav .role-tag { padding: 0 10px 12px; font-size: 11px; color: var(--muted); }

    .main { padding: 28px var(--gutter) 64px; max-width: 100%; }
    .page-head { display: flex; align-items: flex-end; justify-content: space-between; gap: var(--gap-md); flex-wrap: wrap; margin-bottom: var(--gap-lg); }
    .page-head h1 { font-size: var(--fs-h1); letter-spacing: -0.015em; font-weight: 600; }
    .page-head p { color: var(--muted); font-size: 14px; margin-top: 6px; max-width: 60ch; }
    .eyebrow { font-size: 11px; letter-spacing: 0.12em; text-transform: uppercase; color: var(--accent); margin: 0; }

    .card { background: var(--surface); border: 1px solid var(--border); border-radius: var(--radius-lg); padding: 18px; }
    .btn { display: inline-flex; align-items: center; gap: 6px; padding: 8px 13px; border-radius: var(--radius); border: 1px solid transparent; font-size: 13px; font-weight: 500; }
    .btn-primary { background: var(--accent); color: var(--surface); border-color: var(--accent); }
    .btn-primary:hover { background: color-mix(in oklch, var(--accent) 88%, black); }
    .btn-secondary { background: transparent; color: var(--fg); border-color: var(--border); }
    .btn-secondary:hover { border-color: var(--fg); }
    .btn-danger { background: transparent; color: var(--danger); border-color: color-mix(in oklch, var(--danger) 40%, var(--border)); }
    .btn-danger:hover { background: color-mix(in oklch, var(--danger) 10%, transparent); }
    .btn:disabled { opacity: 0.5; cursor: not-allowed; }

    .brand-chips { display: flex; gap: 8px; flex-wrap: wrap; }
    .brand-chip { padding: 6px 14px; border-radius: 999px; border: 1px solid var(--border); background: var(--surface); color: var(--muted); font-size: 12.5px; font-weight: 500; }
    .brand-chip.active { background: var(--accent); color: var(--surface); border-color: var(--accent); }

    .lib-layout { display: grid; grid-template-columns: 1fr 300px; gap: var(--gap-lg); align-items: start; margin-top: var(--gap-lg); }
    @media (max-width: 1000px) { .lib-layout { grid-template-columns: 1fr; } }

    .cal-header { display: flex; align-items: center; justify-content: space-between; margin-bottom: 14px; }
    .cal-nav-btn { width: 32px; height: 32px; border-radius: 8px; border: 1px solid var(--border); background: var(--surface); display: grid; place-items: center; }
    .cal-nav-btn:hover { border-color: var(--fg); }
    .cal-month-label { font-family: var(--font-display); font-size: 18px; font-weight: 600; }
    .cal-grid { display: grid; grid-template-columns: repeat(7, 1fr); gap: 6px; }
    .cal-dow { text-align: center; font-size: 11px; color: var(--muted); font-weight: 600; padding-bottom: 6px; text-transform: uppercase; letter-spacing: 0.04em; }
    .cal-day { min-height: 92px; border: 1px solid var(--border); border-radius: 8px; padding: 6px; display: flex; flex-direction: column; gap: 3px; background: var(--surface); }
    .cal-day.other-month { background: var(--fg-soft); opacity: 0.5; }
    .cal-day.today { border-color: var(--accent); box-shadow: inset 0 0 0 1px var(--accent); }
    .cal-day-num { font-size: 11px; color: var(--muted); font-weight: 600; }
    .cal-day.today .cal-day-num { color: var(--accent); }
    .cal-chip { font-size: 10.5px; padding: 3px 6px; border-radius: 5px; background: var(--accent-soft); color: var(--accent); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; cursor: pointer; border-left: 3px solid var(--accent); }
    .cal-chip.assigned { background: color-mix(in oklch, var(--success) 14%, transparent); color: var(--success); border-left-color: var(--success); }
    .cal-chip:hover { filter: brightness(0.95); }

    .pool-item { border: 1px solid var(--border); border-radius: 8px; padding: 10px; margin-bottom: 8px; cursor: pointer; }
    .pool-item:hover { border-color: var(--fg); }
    .pool-item .brand-tag { font-size: 10px; padding: 2px 8px; border-radius: 999px; border: 1px solid var(--border); color: var(--muted); display: inline-block; margin-bottom: 4px; }
    .pool-item .title { font-size: 13px; font-weight: 600; margin-bottom: 2px; }
    .pool-item .sub { font-size: 11.5px; color: var(--muted); }
    .empty-pool { color: var(--muted); font-size: 12.5px; text-align: center; padding: 24px 8px; }

    .field { margin-bottom: 14px; }
    .field label { display: block; font-size: 12.5px; font-weight: 500; margin-bottom: 5px; }
    .field-hint { font-size: 11.5px; color: var(--muted); display: block; margin-top: 4px; }
    .input, .textarea, .select { width: 100%; padding: 9px 11px; border: 1px solid var(--border); border-radius: 8px; font: inherit; font-size: 13px; background: var(--surface); color: var(--fg); }
    .textarea { resize: vertical; min-height: 90px; }
    .form-row-2 { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; }

    .modal-overlay { position: fixed; inset: 0; background: color-mix(in oklch, black 45%, transparent); display: none; align-items: flex-start; justify-content: center; z-index: 1000; padding: 40px 16px; overflow-y: auto; }
    .modal-overlay.show { display: flex; }
    .modal-box { background: var(--surface); border-radius: var(--radius-lg); padding: 24px; max-width: 620px; width: 100%; }
    .modal-box h2 { font-size: 20px; margin-bottom: 4px; }
    .modal-actions { display: flex; justify-content: flex-end; gap: 8px; margin-top: 18px; }
    .modal-close-x { position: absolute; top: 16px; right: 16px; background: none; border: none; color: var(--muted); font-size: 20px; line-height: 1; }

    .status-pill { display: inline-flex; align-items: center; gap: 5px; font-size: 11.5px; padding: 3px 10px; border-radius: 999px; font-weight: 500; }
    .status-pill.unassigned { background: var(--fg-soft); color: var(--muted); }
    .status-pill.assigned { background: color-mix(in oklch, var(--success) 14%, transparent); color: var(--success); }

    .toast { position: fixed; bottom: 24px; left: 50%; transform: translateX(-50%) translateY(20px); background: var(--fg); color: var(--surface); padding: 10px 18px; border-radius: 999px; font-size: 13px; opacity: 0; pointer-events: none; transition: opacity 0.2s ease, transform 0.2s ease; z-index: 2000; }
    .toast.show { opacity: 1; transform: translateX(-50%) translateY(0); }
  </style>
</head>
